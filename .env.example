# 복사해서 .env로 만들고 비밀번호를 채워 사용한다 (.env는 git에 올리지 않음)

# 애플리케이션이 읽는 DB 접속 정보
# 주의: bootRun/IntelliJ는 .env를 자동으로 읽지 않는다 (자동으로 읽는 건 docker compose뿐)
# PowerShell 예시: $env:DB_URL="..."; $env:DB_USERNAME="..."; $env:DB_PASSWORD="..."; $env:JWT_SECRET="..."; $env:REDIS_PASSWORD="..."; ./gradlew bootRun
DB_URL=jdbc:postgresql://localhost:5432/board
DB_USERNAME=
DB_PASSWORD=

# docker compose의 PostgreSQL 컨테이너 설정 (위 DB_* 값과 맞춘다)
POSTGRES_DB=board
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT 서명 비밀키 (Base64, 디코딩 후 32바이트 이상). 반드시 직접 만들어 채운다
# 생성 (PowerShell): [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) }))
# 생성 (Git Bash/Linux): openssl rand -base64 32
JWT_SECRET=
# access_token·refresh_token 쿠키 Secure 속성. HTTPS를 붙이면 true (기본 false)
# COOKIE_SECURE=false

# Redis 비밀번호 (리프레시 토큰 저장소). 반드시 직접 만들어 채운다 (docker compose와 앱이 같은 값을 쓴다)
# 생성 (PowerShell): [Convert]::ToBase64String((1..24 | % { [byte](Get-Random -Max 256) }))
# 생성 (Git Bash/Linux): openssl rand -base64 24
# 앱을 bootRun으로 직접 띄울 때는 환경변수 REDIS_PASSWORD로도 넘긴다
REDIS_PASSWORD=
