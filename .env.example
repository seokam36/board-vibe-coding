# 복사해서 .env로 만들고 비밀번호를 채워 사용한다 (.env는 git에 올리지 않음)

# 애플리케이션이 읽는 DB 접속 정보
# 주의: bootRun/IntelliJ는 .env를 자동으로 읽지 않는다 (자동으로 읽는 건 docker compose뿐)
# PowerShell 예시: $env:DB_URL="..."; $env:DB_USERNAME="..."; $env:DB_PASSWORD="..."; $env:JWT_SECRET="..."; $env:REDIS_PASSWORD="..."; ./gradlew bootRun
DB_URL=jdbc:postgresql://localhost:5432/board
DB_USERNAME=
DB_PASSWORD=

# docker compose의 PostgreSQL 컨테이너 설정 (위 DB_* 값과 맞춘다)
POSTGRES_DB=board
POSTGRES_USER=
POSTGRES_PASSWORD=

# (로컬 개발만) Flutter 개발 서버(5175)에서 글쓰기·로그인 같은 POST를 하려면 주석을 풀어 넣는다.
# Flutter 프록시가 Host를 8080으로 바꿔서 백엔드가 CORS 요청으로 보기 때문(S16-b). 운영 서버 .env에는 넣지 않는다.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175

# JWT 서명 비밀키 (Base64, 디코딩 후 32바이트 이상). 반드시 직접 만들어 채운다
# 생성 (PowerShell): [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) }))
# 생성 (Git Bash/Linux): openssl rand -base64 32
JWT_SECRET=
# access_token·refresh_token 쿠키 Secure 속성. HTTPS를 붙이면 true (기본 false)
# COOKIE_SECURE=false

# Redis 비밀번호 (리프레시 토큰 저장소). 반드시 직접 만들어 채운다 (docker compose와 앱이 같은 값을 쓴다)
# 생성 (PowerShell): [Convert]::ToBase64String((1..24 | % { [byte](Get-Random -Max 256) }))
# 생성 (Git Bash/Linux): openssl rand -base64 24
# 앱을 bootRun으로 직접 띄울 때는 환경변수 REDIS_PASSWORD로도 넘긴다
REDIS_PASSWORD=

# 허가서 번호 해시용 비밀 값 (S20-b). 반드시 직접 만들어 채운다(비거나 32바이트보다 짧으면 앱이 시작 때 실패). 서버 .env에도 같은 방식으로 넣는다.
# 한 번 정하면 바꾸지 않는다: 바꾸면 이미 저장된 허가서 번호 해시와 안 맞아 "같은 허가서 중복 승인" 확인이 무력해진다.
# 생성 (Git Bash/Linux): openssl rand -base64 48
# 생성 (PowerShell): [Convert]::ToBase64String((1..48 | % { [byte](Get-Random -Max 256) }))
PERMIT_HASH_SECRET=

# 허가서 사진 글자 판독기 (S20-e2). PERMIT_OCR_MODE=off(기본, 항상 못 읽음 = 모든 신청이 관리자 대기) | vision(구글 Cloud Vision). 그 밖의 값이면 시작 때 실패한다.
# 운영 서버는 vision으로 켜져 있다(2026-11-18). 끄려면 off로 바꾸거나 줄을 지우거나 주석 처리한다.
# PERMIT_OCR_MODE는 빈 값으로 두지 말고(빈 값이면 시작 실패), 쓰지 않을 땐 줄을 지우거나 주석 처리한다. 값은 off 또는 vision.
# PERMIT_OCR_MODE=off
# vision 모드일 때만 필요. Vision 전용 키로, Gemini 키와는 다른 프로젝트·결제로 만든다(키의 API 제한은 Cloud Vision API만).
# 이 예시 파일에 절대 쓰지 말고 내 .env나 서버 환경변수에만 둔다. 앞뒤 공백·줄바꿈이 끼면 시작 때 실패한다.
VISION_API_KEY=
# 사진 한 장 판독의 전체 상한(기본 10s, 숫자만 쓰면 초, 0 이하는 시작 실패). 신청(POST)이 판독 시간만큼 늦어질 수 있다.
# VISION_TIMEOUT=10s
# 서버 전체(모든 회원 합계) 하루 구글 Vision 호출 상한(서울 날짜). 기본 30. 넘으면 구글을 부르지 않고 관리자 대기. 0이면 상한 없음, 음수면 시작 실패.
# Vision 월 무료 1,000건을 지키려는 안전장치(계정을 여러 개 만들어도 못 넘김). 줄이 없어도 30으로 켜져 있다.
# VISION_GLOBAL_PER_DAY=30

# 사진 저장소 (S13-g6). s3 = AWS S3 버킷, local = 폴더
# docker compose(운영)에서는 이 줄을 생략하면 s3가 쓰인다. 앱을 bootRun으로 직접 띄울 때는 기본값이 local이다(개발은 local로 충분)
# bootRun에서 s3를 쓰려면 PHOTO_STORAGE·PHOTO_S3_BUCKET·PHOTO_S3_REGION을 모두 환경변수로 넘기고,
# 내 PC에는 EC2 역할이 없으므로 AWS 자격 증명도 따로 있어야 한다(없으면 시작 때 버킷 확인에서 실패)
# PHOTO_STORAGE=s3
# 운영(s3)에서 필수 (비면 앱이 시작 때 변수 이름을 알려 주며 실패). 버킷 이름은 저장소에 적지 말고 서버 .env에만 둔다
PHOTO_S3_BUCKET=
# compose에서는 생략하면 서울(ap-northeast-2). bootRun으로 s3를 쓸 때는 필수. 운영 자격 증명은 키 없이 EC2의 IAM 역할을 쓴다
# PHOTO_S3_REGION=ap-northeast-2

# AI(LLM) 연결 (S17-b). off(기본) = AI 끔, ollama = 내 PC의 Ollama, gemini = 구글 제미나이 (그 밖의 값이면 앱이 시작 때 실패)
# 이 연결은 챗봇(POST /chat)이 쓴다(S17-c~). off면 /chat은 항상 503이다. 운영 서버(t3.micro)는 로컬 모델을 못 올려 ollama는 못 쓴다
# 운영 서버 .env에는 LLM_MODE=gemini와 GEMINI_API_KEY 두 줄만 넣는다(S18-e). 모델·시간·상한은 docker-compose.yml 기본값이 운영 값이다.
# 절차는 docs/deploy.md "S18 배포 후 확인". 로컬에서 gemini로 테스트하면 운영과 같은 무료 한도를 쓴다(같은 키일 때)
# LLM_MODE는 빈 값으로 두지 말고, 쓰지 않을 땐 줄을 지우거나 주석 처리한다(bootRun에서 빈 값이면 시작 실패. 운영 compose는 빈 값을 off로 채운다)
# LLM_MODE=off
# ollama 모드일 때: 서버 주소(기본 http://localhost:11434), 모델(기본 qwen3:8b), 질문 하나 전체의 시간 예산(기본 60s)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
# 제한 시간 단위: 60s처럼 쓰거나 숫자만 쓰면 초(60 = 60초). 0 이하는 시작 실패
# AI 호출 하나가 아니라 질문 하나 전체 예산이다(양식 호출 + 답 호출 2번이 나눠 씀).
# 이 값을 올리면 flutter_app/nginx.conf의 /api/chat(75초)와 flutter_app/lib/pages/chat_page.dart(90초)도 같이 올린다(서버 < nginx < 화면).
# OLLAMA_TIMEOUT=60s

# gemini 모드일 때 (S18-c): LLM_MODE=gemini. 무료 등급(AI Studio 키)을 쓴다(분당 15번·하루 500번 한도, 보낸 질문이 구글 제품 개선에 쓰일 수 있음).
# 키는 이 예시 파일에 절대 쓰지 말고, 내 .env(git에 안 올라감)나 서버 환경변수에만 둔다. 앞뒤 공백·줄바꿈이 끼면 시작 때 실패한다.
GEMINI_API_KEY=
# 모델은 3.x 계열로(코드의 thinkingLevel=minimal 설정이 3.x 전용이라 2.5 이하는 오류). models/ 접두사는 붙이지 않는다
# GEMINI_MODEL=gemini-3.5-flash-lite
# 질문 하나 전체의 시간 예산(기본 30s, 숫자만 쓰면 초, 0 이하는 시작 실패). 양식 호출 + 답 호출이 나눠 쓴다.
# 이 값을 올리면 flutter_app/nginx.conf의 /api/chat(75초)와 flutter_app/lib/pages/chat_page.dart(90초)도 같이 올린다(서버 < nginx 75초 < 화면 90초).
# GEMINI_TIMEOUT=30s
# 챗봇 서버 전체 질문 상한 (S18-d): 모든 회원 합계. 0이면 검사 안 함(앱 기본, 로컬 개발은 안 써도 된다). 음수는 시작 실패.
# 운영 compose는 이 값을 안 넣어도 7·200을 넘긴다(S18-e).
# 모드(LLM_MODE)와 상관없이 값이 0보다 크면 센다(ollama 모드도 포함). off 모드는 그 전에 바로 503이라 안 센다.
# 단위는 "질문"(질문 하나 = AI 호출 최대 2번). gemini 운영 권장: 분 7(= 15÷2), 하루 200(= 500×0.8÷2). 하루는 태평양 자정(한국 오후 4~5시)에 리셋.
# CHAT_GLOBAL_PER_MINUTE=7
# CHAT_GLOBAL_PER_DAY=200

# ---------- S22: 서버가 켜질 때 DNS 자동 고침 (운영 EC2 전용, 로컬 개발은 안 써도 된다) ----------
# 앱·compose는 이 값을 읽지 않는다. 서버의 ~/board/cloudflare-ddns.sh 가 이 세 줄만 골라 읽는다(docs/deploy.md "S22 DNS 자동 고침").
# CF_API_TOKEN: Cloudflare API 토큰(그 도메인의 DNS 편집 권한만). 비밀 값 -> 서버 .env에 nano로 직접, 저장소·채팅 금지
# CF_ZONE_ID: 도메인 개요 화면의 영역 ID(32글자, 비밀 아님) / CF_RECORD_NAME: 고칠 이름 전체(예: kampus.<도메인>)
# CF_API_TOKEN=
# CF_ZONE_ID=
# CF_RECORD_NAME=

# ---------- S24-b: 푸시 알림 (FCM) ----------
# PUSH_MODE: off(기본, 아무것도 안 보냄) 또는 fcm. 그 밖의 값이면 시작 실패. 로컬 개발은 안 써도 된다.
# FCM_CREDENTIALS_FILE: fcm 모드일 때 필수. Firebase 서비스 계정 키 파일(JSON)의 경로(파일 안에 비밀 키가 있다 -> 저장소·채팅 금지). 없는 파일이거나 서비스 계정 키가 아니면 시작 실패.
# PUSH_MODE=
# FCM_CREDENTIALS_FILE=
# FCM_TIMEOUT=10s

# 중고 글 사진 자동 검사 (S30). MARKET_SAFESEARCH_MODE=off(기본, 검사 안 함 = 통과) | vision(구글 SafeSearch로 성인물·폭력·선정성 등급 검사). 그 밖의 값이면 시작 때 실패한다.
# vision이면 위의 VISION_API_KEY(허가서 판독과 같은 키)가 필요하다. 빈 값으로 두지 말고, 쓰지 않을 땐 줄을 지우거나 주석 처리한다.
# MARKET_SAFESEARCH_MODE=off
# 서버 전체 하루 구글 호출 상한(서울 날짜, 허가서 판독 상한과 따로 센다). 기본 30. 넘으면 구글을 부르지 않고 검사 없이 통과. 0이면 상한 없음, 음수면 시작 실패.
# MARKET_SAFESEARCH_PER_DAY=30
# 사진 한 장 검사의 전체 상한(기본 5s, 숫자만 쓰면 초). 넘으면 검사 없이 통과.
# MARKET_SAFESEARCH_TIMEOUT=5s
