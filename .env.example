# 복사해서 .env로 만들고 비밀번호를 채워 사용한다 (.env는 git에 올리지 않음)

# 애플리케이션이 읽는 DB 접속 정보
# 주의: bootRun/IntelliJ는 .env를 자동으로 읽지 않는다 (자동으로 읽는 건 docker compose뿐)
# PowerShell 예시: $env:DB_URL="..."; $env:DB_USERNAME="..."; $env:DB_PASSWORD="..."; $env:JWT_SECRET="..."; $env:REDIS_PASSWORD="..."; ./gradlew bootRun
DB_URL=jdbc:postgresql://localhost:5432/board
DB_USERNAME=
DB_PASSWORD=

# docker compose의 PostgreSQL 컨테이너 설정 (위 DB_* 값과 맞춘다)
POSTGRES_DB=board
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT 서명 비밀키 (Base64, 디코딩 후 32바이트 이상). 반드시 직접 만들어 채운다
# 생성 (PowerShell): [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) }))
# 생성 (Git Bash/Linux): openssl rand -base64 32
JWT_SECRET=
# access_token·refresh_token 쿠키 Secure 속성. HTTPS를 붙이면 true (기본 false)
# COOKIE_SECURE=false

# Redis 비밀번호 (리프레시 토큰 저장소). 반드시 직접 만들어 채운다 (docker compose와 앱이 같은 값을 쓴다)
# 생성 (PowerShell): [Convert]::ToBase64String((1..24 | % { [byte](Get-Random -Max 256) }))
# 생성 (Git Bash/Linux): openssl rand -base64 24
# 앱을 bootRun으로 직접 띄울 때는 환경변수 REDIS_PASSWORD로도 넘긴다
REDIS_PASSWORD=

# 학교 메일 인증 코드 발송 방식 (S10-e). log(기본) = 실제 발송 없이 로그에만 찍음, smtp = 실제 발송
# MAIL_MODE=log
# smtp 모드일 때 아래 네 값이 모두 필수 (하나라도 비면 앱이 시작 때 이름을 알려 주며 실패)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Gmail 앱 비밀번호 (계정 비밀번호가 아니라 2단계 인증 후 발급하는 16자리)
MAIL_PASSWORD=
# 보내는 사람 주소 (Gmail이면 MAIL_USERNAME과 같은 주소)
MAIL_FROM=

# 사진 저장소 (S13-g6). s3 = AWS S3 버킷, local = 폴더
# docker compose(운영)에서는 이 줄을 생략하면 s3가 쓰인다. 앱을 bootRun으로 직접 띄울 때는 기본값이 local이다(개발은 local로 충분)
# bootRun에서 s3를 쓰려면 PHOTO_STORAGE·PHOTO_S3_BUCKET·PHOTO_S3_REGION을 모두 환경변수로 넘기고,
# 내 PC에는 EC2 역할이 없으므로 AWS 자격 증명도 따로 있어야 한다(없으면 시작 때 버킷 확인에서 실패)
# PHOTO_STORAGE=s3
# 운영(s3)에서 필수 (비면 앱이 시작 때 변수 이름을 알려 주며 실패). 버킷 이름은 저장소에 적지 말고 서버 .env에만 둔다
PHOTO_S3_BUCKET=
# compose에서는 생략하면 서울(ap-northeast-2). bootRun으로 s3를 쓸 때는 필수. 운영 자격 증명은 키 없이 EC2의 IAM 역할을 쓴다
# PHOTO_S3_REGION=ap-northeast-2
